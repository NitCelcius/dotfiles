.gitconfig.local

# Unity-MCP skills are optional and project-specific — welcome-claude copies
# them into a Unity project's local .claude/skills/ on demand instead of
# chezmoi applying them globally to every machine.
.claude/skills/unity-mcp-core
.claude/skills/unity-mcp-scene-objects
.claude/skills/unity-mcp-scripting
.claude/skills/unity-mcp-assets-materials
.claude/skills/unity-mcp-ui
.claude/skills/unity-mcp-camera-graphics
.claude/skills/unity-mcp-testing-editor
.claude/skills/unity-mcp-packages-docs

# organize-photos depends on scripts, a 7z install and a Bitwarden item that
# exist only on the home server, so no other machine gets it.
{{ if ne .chezmoi.hostname "Icy-NucM6U" -}}
.claude/skills/organize-photos
{{ end -}}

# Regression test for the Stop hook. Runs from the dotfiles checkout, where git
# and a scratch directory are available; nothing needs it on a deployed machine.
.claude/verify-on-stop/test_verify_on_stop.py
.claude/session-start-diff/test_session_start_diff.py

# Project instructions and test config for working on this repo, not files for the
# home directory.
CLAUDE.md
pytest.ini

# Running the hook or its test from the source tree leaves bytecode behind, and
# chezmoi would otherwise deploy it.
**/__pycache__
obsidian
