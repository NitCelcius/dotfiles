{{- /* chezmoi:modify-template */ -}}
{{- /* Partial management: git appends [safe] entries to this file at     */ -}}
{{- /* runtime, so that section is carried over from the live file        */ -}}
{{- /* instead of being overwritten. Everything else is owned here.       */ -}}
{{- $safe := "" -}}
{{- $inSafe := false -}}
{{- range splitList "\n" .chezmoi.stdin -}}
{{-   $line := trimSuffix "\r" . -}}
{{-   if hasPrefix "[" (trim $line) -}}{{- $inSafe = eq (trim $line) "[safe]" -}}{{- end -}}
{{-   if and $inSafe (ne (trim $line) "") -}}{{- $safe = printf "%s%s\n" $safe $line -}}{{- end -}}
{{- end -}}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = NitCelcius
	email = nitcelcius@nitcelcius.me
	signingkey = {{ (bitwarden "item" "b70567a7-5d86-4db3-8741-b34200f283b4").sshKey.publicKey }}
[core]
	editor = code --wait
[hook "sig-summary"]
	event = post-commit
	command = {{ .chezmoi.homeDir }}/.config/git/sig-summary.sh
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[commit]
	gpgsign = true
[rerere]
	enabled = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
[push]
	autoSetupRemote = true
[alias]
	s = status
	d = diff
	a = add
	cm = commit -m
	ca = commit --amend
	co = checkout
	cb = checkout -b
	sw = switch
	swc = switch -c
	br = branch
	l = log --oneline --graph --decorate -20
	la = log --oneline --graph --decorate --all
	rc = rebase --continue
	ri = rebase -i
	p = push
	pushf = push --force-with-lease
	pullr = pull --rebase
	unstage = reset HEAD --
	last = log -1 HEAD
	sl = stash list
	conflicts = diff HEAD --check
	resign = commit -S --amend --no-edit
	ra = rebase --abort
	sig = log --show-signature -1
	spush = stash push
	spop = stash pop
	spushm = stash push -m
	wt  = worktree list
	wta = worktree add
	wtr = worktree remove
	f = fetch
	fp = fetch --prune
[include]
	path = ~/.gitconfig.local
{{ $safe -}}
