{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Global",
      "bindings": {
        "ctrl+]": "app:openArtifact"
      }
    },
    {
      "context": "Confirmation",
      "bindings": {
        "y": "confirm:yes",
        "n": "confirm:no"
      }
    },
    {
      "context": "MessageSelector",
      "bindings": {
        "ctrl+up": "select:first",
        "shift+up": "select:first",
        "meta+up": "select:first",
        "shift+k": "select:first",
        "ctrl+down": "select:last",
        "shift+down": "select:last",
        "meta+down": "select:last",
        "shift+j": "select:last"
      }
    }
  ]
}
