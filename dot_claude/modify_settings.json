{{- /* chezmoi:modify-template */ -}}
{{- /* Partial management. Claude Code writes this file at runtime, so the   */ -}}
{{- /* live contents pass through and only the keys below are enforced:      */ -}}
{{- /*   hooks.PostCompact  — drives the feedback-on-compaction skill        */ -}}
{{- /*   hooks.Stop        — runs the project's quick verification, and      */ -}}
{{- /*                       exits 2 to keep Claude from closing on a claim  */ -}}
{{- /*   hooks.SessionStart — flags a pending diff, commit ask at 300+      */ -}}
{{- /*   hooks.SessionStart, PostToolUse — prompt for the dotfiles change log */ -}}
{{- /*   hooks.PermissionRequest, PreToolUse, Stop (play-sound.sh) — sound   */ -}}
{{- /*                       cues for permission prompts, AskUserQuestion,  */ -}}
{{- /*                       and task completion                            */ -}}
{{- /*   hooks.PreToolUse   — asks before a delete a shim relies on         */ -}}
{{- /*   hooks.PreToolUse   — asks before a delete through a link           */ -}}
{{- /*   hooks.PreToolUse   — asks before deletes through links or shims    */ -}}
{{- /*   hooks.PreToolUse   — asks on link/shim deletes, denies link globs  */ -}}
{{- /*   hooks.PreToolUse   — git-gate: allows a forced branch delete it has */ -}}
{{- /*                       checked, asks when one loses unpushed work,     */ -}}
{{- /*                       gates force and delete pushes                   */ -}}
{{- /*   enabledPlugins.*   — off globally except $keepOn; projects opt in   */ -}}
{{- /*   permissions.allow  — pre-cleared read-only MCP/chezmoi/git calls,   */ -}}
{{- /*                       plus rebases                                    */ -}}
{{- /*   permissions.deny   — blocks bare force-push outright                */ -}}
{{- /*   permissions.ask    — approval gate for irreversible git/gh actions  */ -}}
{{- /*   (git rules in allow/deny/ask are mirrored as PowerShell(...) rules) */ -}}
{{- /*   syncClaudeAiSkills — false: claude.ai skills stay out of the context  */ -}}
{{- /*   cleanupPeriodDays  — 9999: session transcripts are kept ~indefinitely */ -}}
{{- /*   worktree.baseRef   — Workcell executors branch from the current HEAD */ -}}
{{- /*   permissions.additionalDirectories — the Workcell record root         */ -}}
{{- /*   hooks.<workcell>   — removed; the Workcell plugin registers its own  */ -}}
{{- /*   env.CLAUDE_CODE_ENABLE_TELEMETRY, env.OTEL_* — OTLP export to PostHog */ -}}
{{- /*                       Logs/Metrics; token comes from Bitwarden        */ -}}
{{- /* model, effortLevel, modelSettings and voice are deliberately left     */ -}}
{{- /* alone: they are per-session choices, not configuration.              */ -}}
{{- $keepOn := list "notion@claude-plugins-official" -}}
{{- /* Unioned, not replaced, so rules added at runtime survive an apply. */ -}}
{{- $allowRules := list
      "mcp__UnityMCP__read_console"
      "mcp__UnityMCP__find_gameobjects"
      "mcp__claude-in-chrome__tabs_context_mcp"
      "mcp__claude-in-chrome__find"
      "mcp__claude-in-chrome__get_page_text"
      "mcp__claude-in-chrome__read_console_messages"
      "Bash(chezmoi diff *)"
      "Bash(chezmoi source-path *)"
      "Bash(git check-ignore *)" -}}
{{- /* Local-only history edits. Publishing a rebase needs a force push, which  */ -}}
{{- /* stays gated. Forced branch deletes have no rule: git-gate allows the     */ -}}
{{- /* ones it has checked, so a hook failure falls back to a prompt.          */ -}}
{{- $gitAllowRules := list
      "Bash(git rebase*)"
      "Bash(git pull --rebase*)"
      "Bash(git pull -r*)" -}}
{{- $denyRules := list
      "Bash(git push --force)"
      "Bash(git push --force *)"
      "Bash(git push -f)"
      "Bash(git push -f *)"
      "Bash(git push * --force)"
      "Bash(git push * --force *)"
      "Bash(git push * -f)"
      "Bash(git push * -f *)" -}}
{{- $askRules := list
      "Bash(gh pr create*)"
      "Bash(git push --force*)"
      "Bash(git push -f*)"
      "Bash(git push * --force-with-lease*)"
      "Bash(git push --force-with-lease*)"
      "Bash(git reset --hard*)"
      "Bash(gh pr merge*)"
      "Bash(git push origin --delete*)"
      "Bash(gh pr close*)"
      "Bash(gh issue close*)" -}}
{{- /* Ask rules this template used to add. The union below would keep them in */ -}}
{{- /* the live file forever, so they are dropped from it explicitly.          */ -}}
{{- $retiredAskRules := list
      "Bash(git rebase*)"
      "Bash(git pull --rebase*)"
      "Bash(git pull -r*)"
      "Bash(git branch -D*)" -}}
{{- /* Likewise for allow rules: a static allow matched forced deletes the hook  */ -}}
{{- /* could not see into (`timeout 10 git branch -D x`), so it is dropped.     */ -}}
{{- $retiredAllowRules := list
      "Bash(git branch -D *)"
      "PowerShell(git branch -D *)" -}}
{{- /* Bash(...) rules never match the PowerShell tool, so mirror the git ones. */ -}}
{{- range $r := $gitAllowRules -}}
{{-   $allowRules = append (append $allowRules $r) (replace "Bash(" "PowerShell(" $r) -}}
{{- end -}}
{{- range $r := $denyRules -}}
{{-   $denyRules = append $denyRules (replace "Bash(" "PowerShell(" $r) -}}
{{- end -}}
{{- range $r := $askRules -}}
{{-   $askRules = append $askRules (replace "Bash(" "PowerShell(" $r) -}}
{{- end -}}
{{- $in := default "{}" (trim .chezmoi.stdin) -}}
{{- $cfg := fromJson $in -}}
{{- $keptAllow := list -}}
{{- range default (list) (dig "permissions" "allow" (list) $cfg) -}}
{{-   if not (has . $retiredAllowRules) -}}{{- $keptAllow = append $keptAllow . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "permissions.allow" (concat $keptAllow $allowRules | uniq) $cfg -}}
{{- $liveDeny := default (list) (dig "permissions" "deny" (list) $cfg) -}}
{{- $cfg = setValueAtPath "permissions.deny" (concat $liveDeny $denyRules | uniq) $cfg -}}
{{- $keptAsk := list -}}
{{- range default (list) (dig "permissions" "ask" (list) $cfg) -}}
{{-   if not (has . $retiredAskRules) -}}{{- $keptAsk = append $keptAsk . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "permissions.ask" (concat $keptAsk $askRules | uniq) $cfg -}}
{{- $cfg = setValueAtPath "syncClaudeAiSkills" false $cfg -}}
{{- $cfg = setValueAtPath "cleanupPeriodDays" 9999 $cfg -}}
{{- /* Telemetry. Prompt text stays out: OTEL_LOG_USER_PROMPTS is left unset. */ -}}
{{- $phToken := (bitwarden "item" "posthog / claude code / Project token").login.password -}}
{{- $otelEnv := dict
      "CLAUDE_CODE_ENABLE_TELEMETRY" "1"
      "OTEL_LOGS_EXPORTER" "otlp"
      "OTEL_METRICS_EXPORTER" "otlp"
      "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL" "http/protobuf"
      "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL" "http/protobuf"
      "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT" "https://us.i.posthog.com/i/v1/logs"
      "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT" "https://us.i.posthog.com/i/v1/metrics"
      "OTEL_EXPORTER_OTLP_HEADERS" (printf "Authorization=Bearer %s" $phToken) -}}
{{- range $k, $v := $otelEnv -}}
{{-   $cfg = setValueAtPath (printf "env.%s" $k) $v $cfg -}}
{{- end -}}
{{- $script := printf "%s/.claude/feedback-on-compaction/feedback_on_compaction.py" .chezmoi.homeDir -}}
{{- $hook := dict "type" "command" "command" (printf "python \"%s\" collect" $script) "timeout" 10 -}}
{{- $cfg = setValueAtPath "hooks.PostCompact" (list (dict "hooks" (list $hook))) $cfg -}}
{{- /* Timeout sits above the hook's own 180s cap so the hook reports a slow */ -}}
{{- /* quick command itself rather than being killed without explanation.    */ -}}
{{- $verify := printf "%s/.claude/verify-on-stop/verify_on_stop.py" .chezmoi.homeDir -}}
{{- $stopHook := dict "type" "command" "command" (printf "python \"%s\"" $verify) "timeout" 240 -}}
{{- $keptStop := list -}}
{{- range default (list) (dig "hooks" "Stop" (list) $cfg) -}}
{{-   if not (contains "verify_on_stop.py" (toJson .)) -}}{{- $keptStop = append $keptStop . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.Stop" (append $keptStop (dict "hooks" (list $stopHook))) $cfg -}}
{{- $diffCheck := printf "%s/.claude/session-start-diff/session_start_diff.py" .chezmoi.homeDir -}}
{{- $startHook := dict "type" "command" "command" (printf "python \"%s\"" $diffCheck) "timeout" 15 -}}
{{- $keptStart := list -}}
{{- range default (list) (dig "hooks" "SessionStart" (list) $cfg) -}}
{{-   if not (contains "session_start_diff.py" (toJson .)) -}}{{- $keptStart = append $keptStart . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.SessionStart" (append $keptStart (dict "hooks" (list $startHook))) $cfg -}}
{{- $changeLog := printf "%s/.claude/dotfiles-change-log/dotfiles_change_log.py" .chezmoi.homeDir -}}
{{- $logStartHook := dict "type" "command" "command" (printf "python \"%s\" session-start" $changeLog) "timeout" 15 -}}
{{- $keptLogStart := list -}}
{{- range default (list) (dig "hooks" "SessionStart" (list) $cfg) -}}
{{-   if not (contains "dotfiles_change_log.py" (toJson .)) -}}{{- $keptLogStart = append $keptLogStart . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.SessionStart" (append $keptLogStart (dict "hooks" (list $logStartHook))) $cfg -}}
{{- $logCommitHook := dict "type" "command" "command" (printf "python \"%s\" post-commit" $changeLog) "timeout" 15 -}}
{{- $keptPost := list -}}
{{- range default (list) (dig "hooks" "PostToolUse" (list) $cfg) -}}
{{-   if not (contains "dotfiles_change_log.py" (toJson .)) -}}{{- $keptPost = append $keptPost . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.PostToolUse" (append $keptPost (dict "matcher" "Bash|PowerShell" "hooks" (list $logCommitHook))) $cfg -}}
{{- /* Sound-effect hooks. Hardcoded here (not left to a live-file merge) so a */ -}}
{{- /* fresh machine gets them too, not just one where they were hand-added.   */ -}}
{{- $soundCmd := "~/.claude/hooks/play-sound.sh" -}}
{{- $permHook := dict "matcher" "" "hooks" (list (dict "type" "command" "command" (printf "%s permission" $soundCmd))) -}}
{{- $keptPerm := list -}}
{{- range default (list) (dig "hooks" "PermissionRequest" (list) $cfg) -}}
{{-   if not (contains "play-sound.sh" (toJson .)) -}}{{- $keptPerm = append $keptPerm . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.PermissionRequest" (append $keptPerm $permHook) $cfg -}}
{{- $questionHook := dict "matcher" "AskUserQuestion" "hooks" (list (dict "type" "command" "command" (printf "%s question" $soundCmd))) -}}
{{- $keptPreToolUse := list -}}
{{- range default (list) (dig "hooks" "PreToolUse" (list) $cfg) -}}
{{-   if not (contains "play-sound.sh" (toJson .)) -}}{{- $keptPreToolUse = append $keptPreToolUse . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.PreToolUse" (append $keptPreToolUse $questionHook) $cfg -}}
{{- $completeHook := dict "matcher" "" "hooks" (list (dict "type" "command" "command" (printf "%s complete" $soundCmd))) -}}
{{- $keptStopSound := list -}}
{{- range default (list) (dig "hooks" "Stop" (list) $cfg) -}}
{{-   if not (contains "play-sound.sh" (toJson .)) -}}{{- $keptStopSound = append $keptStopSound . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.Stop" (prepend $keptStopSound $completeHook) $cfg -}}
{{- $rmGuard := printf "%s/.claude/rm-junction-guard/rm_junction_guard.py" .chezmoi.homeDir -}}
{{- $rmHook := dict "type" "command" "command" (printf "python \"%s\"" $rmGuard) "timeout" 10 -}}
{{- $keptPre := list -}}
{{- range default (list) (dig "hooks" "PreToolUse" (list) $cfg) -}}
{{-   if not (contains "rm_junction_guard.py" (toJson .)) -}}{{- $keptPre = append $keptPre . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.PreToolUse" (append $keptPre (dict "matcher" "Bash|PowerShell" "hooks" (list $rmHook))) $cfg -}}
{{- /* Timeout covers a few 5s-capped git calls per deleted branch; a timed-out */ -}}
{{- /* hook gives no decision, so a forced delete falls back to a prompt.      */ -}}
{{- $gitGate := printf "%s/.claude/git-gate/git_gate.py" .chezmoi.homeDir -}}
{{- $gateHook := dict "type" "command" "command" (printf "python \"%s\"" $gitGate) "timeout" 30 -}}
{{- $keptGate := list -}}
{{- range default (list) (dig "hooks" "PreToolUse" (list) $cfg) -}}
{{-   if not (contains "git_gate.py" (toJson .)) -}}{{- $keptGate = append $keptGate . -}}{{- end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks.PreToolUse" (append $keptGate (dict "matcher" "Bash|PowerShell" "hooks" (list $gateHook))) $cfg -}}
{{- range $name, $_ := (default (dict) (get $cfg "enabledPlugins")) -}}
{{-   $cfg = setValueAtPath (printf "enabledPlugins.%s" $name) (has $name $keepOn) $cfg -}}
{{- end -}}
{{- /* Workcell. Executors read the main checkout's HEAD, so worktrees must  */ -}}
{{- /* branch from it rather than the default branch.                        */ -}}
{{- $cfg = setValueAtPath "worktree.baseRef" "head" $cfg -}}
{{- $wcRoot := printf "%s/.local/share/workcell" .chezmoi.homeDir -}}
{{- $liveDirs := default (list) (dig "permissions" "additionalDirectories" (list) $cfg) -}}
{{- $cfg = setValueAtPath "permissions.additionalDirectories" (concat $liveDirs (list $wcRoot) | uniq) $cfg -}}
{{- /* These two skills moved into the Workcell plugin, where the bare names  */ -}}
{{- /* no longer resolve. Drop the stale keys an earlier apply left behind.   */ -}}
{{- $so := default (dict) (get $cfg "skillOverrides") -}}
{{- $so = unset (unset $so "executing-delegated-task") "using-workcell" -}}
{{- if $so -}}
{{-   $cfg = setValueAtPath "skillOverrides" $so $cfg -}}
{{- else -}}
{{-   $cfg = unset $cfg "skillOverrides" -}}
{{- end -}}
{{- /* Telemetry hooks now ship with the Workcell plugin. Strip any entry a  */ -}}
{{- /* previous apply wrote into the live file so they do not fire twice.     */ -}}
{{- $hooksOut := dict -}}
{{- range $ev, $entries := (default (dict) (get $cfg "hooks")) -}}
{{-   $kept := list -}}
{{-   range $e := $entries -}}
{{-     if not (contains "workcell_hook.py" (toJson $e)) -}}
{{-       $kept = append $kept $e -}}
{{-     end -}}
{{-   end -}}
{{-   if $kept -}}
{{-     $hooksOut = set $hooksOut $ev $kept -}}
{{-   end -}}
{{- end -}}
{{- $cfg = setValueAtPath "hooks" $hooksOut $cfg -}}
{{- $cfg | toPrettyJson -}}
