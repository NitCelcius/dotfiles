# Auto detect text files and perform LF normalization
* text=auto

# Markdown is deployed by chezmoi to Windows destinations; keep CRLF in the
# working tree so source and destination compare equal.
*.md text eol=crlf

# Shell hooks must stay LF — a CRLF shebang (#!/bin/sh\r) fails to execute
# on a Windows checkout.
.githooks/** text eol=lf
dot_config/git/executable_sig-summary.sh text eol=lf
dot_claude/hooks/executable_play-sound.sh text eol=lf
